{
  "name": "@wunschliste/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "mail:test": "tsx --env-file-if-exists=../../.env src/mail-test.ts",
    "admin": "tsx --env-file-if-exists=../../.env src/admin-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@wunschliste/shared": "workspace:*",
    "better-auth": "~1.7.26",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nodemailer": "^10.6.0",
    "postgres": "^4.1.1",
    "sharp": "~0.34.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
