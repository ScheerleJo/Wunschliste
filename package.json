{
  "name": "wunschliste",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @wunschliste/web build",
    "start": "pnpm --filter @wunschliste/api start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @wunschliste/api db:generate",
    "db:migrate": "pnpm --filter @wunschliste/api db:migrate"
  }
}
