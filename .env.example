# Öffentliche URL, unter der die Web-App erreichbar ist.
# Entwicklung: Vite-Dev-Server; Produktion: https://wunschbaum.basislager.cloud
APP_URL=http://localhost:5173

# Port der API (in Produktion liefert die API auch die Web-App aus)
PORT=3000

# Nur für die lokale Entwicklung. In Produktion setzt docker-compose.yml die DATABASE_URL selbst.
DATABASE_URL=postgres://wunschliste:wunschliste@localhost:5432/wunschliste

# Nur Produktion (docker compose): Passwort der Datenbank, z. B.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Port, auf dem der Container auf dem Server lauscht (Ziel für den Nginx Proxy Manager)
APP_PORT=3000

# Zufälliger, langer Wert, z. B.: openssl rand -base64 32
BETTER_AUTH_SECRET=bitte-aendern-mindestens-32-zeichen-lang

# Mailversand. Entwicklung: Mailpit (Web-Oberfläche http://localhost:8025).
# Ist SMTP_HOST leer, werden Mails nur in der Konsole ausgegeben.
# Testen: pnpm mail:test deine-adresse@example.com
#
# Beispiele echter Anbieter:
#   IONOS:  SMTP_HOST=smtp.ionos.de        SMTP_PORT=587  SMTP_USER=postfach@deine-domain.de
#   Gmail:  SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_USER=name@gmail.com (App-Passwort!)
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587  SMTP_USER=<Login aus Brevo>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Absender. Leer lassen = Adresse aus SMTP_USER. Bei IONOS, GMX, Gmail usw. muss das die
# Postfach-Adresse (oder ein dort eingerichteter Alias) sein, sonst lehnt der Server ab.
MAIL_FROM="Wunschbaum <wunschbaum@basislager.cloud>"

# Header mit der echten Besucher-IP (für die Begrenzung von Login-Versuchen).
# Hinter Cloudflare: cf-connecting-ip. Leer lassen, wenn kein Proxy davor ist.
IP_HEADERS=

# Font Awesome Pro Package Token (fontawesome.com → Konto → Package Tokens).
# Wird nur beim Bauen gebraucht (pnpm install / docker compose build). Niemals in Git einchecken!
FONTAWESOME_PACKAGE_TOKEN=

# Ablage für hochgeladene Bilder
UPLOAD_DIR=./data/uploads
